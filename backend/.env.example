# Required: Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Custom Search JSON API (if omitted or inactive, curated learning resources are used)
GOOGLE_API_KEY=your_google_search_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Server Configuration
FLASK_ENV=production
PORT=5000
MAX_CONTENT_LENGTH=16777216
CORS_ORIGINS=http://localhost:5173,https://artisight.netlify.app
