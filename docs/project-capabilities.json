{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "project": "ArtiSight",
  "version": "2.0.0",
  "capabilities": {
    "structuredCritique": {
      "status": "implemented_and_verified",
      "model": "gemini-2.5-flash",
      "rubricDimensions": [
        "composition",
        "lighting",
        "focus",
        "color",
        "storytelling",
        "overall"
      ],
      "scoreScale": "0.0-10.0",
      "schemaValidation": "pydantic_v2"
    },
    "deterministicVision": {
      "status": "implemented_and_verified",
      "engine": "opencv-python-headless",
      "metrics": [
        "laplacian_sharpness_variance",
        "luminance_histogram_32_bin",
        "highlight_clipping_percentage",
        "shadow_clipping_percentage",
        "rms_contrast",
        "dominant_color_hex"
      ]
    },
    "exifMetadata": {
      "status": "implemented_and_verified",
      "engine": "pillow",
      "gpsStripped": true,
      "fields": [
        "cameraMake",
        "cameraModel",
        "lensModel",
        "focalLength",
        "aperture",
        "shutterSpeed",
        "iso",
        "captureDate"
      ]
    },
    "compositionOverlays": {
      "status": "implemented_and_verified",
      "type": "svg_vector_overlays",
      "modes": [
        "rule_of_thirds",
        "phi_golden_ratio",
        "center_crosshair",
        "dynamic_diagonals",
        "clean"
      ]
    },
    "clientImageOptimization": {
      "status": "implemented_and_verified",
      "engine": "html5_canvas",
      "maxDimension": 2048,
      "jpegQuality": 0.90
    },
    "practiceAssignments": {
      "status": "implemented_and_verified",
      "components": [
        "problem",
        "evidence",
        "why_it_matters",
        "recommendation",
        "exercise",
        "expected_outcome"
      ]
    },
    "resourceDiscovery": {
      "status": "implemented_and_verified",
      "primary": "curated_photography_knowledge_base",
      "secondary": "google_custom_search_json_api",
      "fallbackGuaranteed": true
    },
    "sessionPersistence": {
      "status": "implemented_and_verified",
      "storage": "sessionStorage",
      "rehydratesOnRefresh": true
    },
    "blip2Model": {
      "status": "deferred_with_justification",
      "reason": "Evaluated during Phase 3. BLIP-2 introduces 30s+ CPU latency and ~15GB memory footprint without exceeding Gemini 2.5 Flash visual reasoning capabilities. Replaced with sub-50ms deterministic OpenCV analysis."
    }
  }
}
